// Учебные имена. Обе ветви читают полные строки одной организации.
ВЫБРАТЬ
    Строки.Ссылка.Дата КАК ДатаОперации,
    Строки.Ссылка КАК ДокументОперации,
    Строки.КлючСтроки КАК КлючСтроки,
    Строки.Ссылка.Точка КАК Точка,
    Строки.Ссылка.Точка.Наименование КАК НазваниеТочки,
    Строки.Товар КАК Товар,
    Строки.Товар.Наименование КАК НазваниеТовара,
    Строки.Товар.Категория КАК Категория,
    Строки.Товар.Категория.Наименование КАК НазваниеКатегории,
    "sale" КАК ВидОперации,
    Строки.Количество КАК Количество,
    Строки.СуммаВТенгеСНДС КАК Сумма
ИЗ
    Документ.УчебнаяПродажа.Строки КАК Строки
ГДЕ
    Строки.Ссылка.Проведен
    И Строки.Ссылка.Организация = &Организация
    И Строки.Ссылка.Дата >= &Начало
    И Строки.Ссылка.Дата < &Конец

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
    Строки.Ссылка.Дата,
    Строки.Ссылка,
    Строки.КлючСтроки,
    Строки.Ссылка.Точка,
    Строки.Ссылка.Точка.Наименование,
    Строки.Товар,
    Строки.Товар.Наименование,
    Строки.Товар.Категория,
    Строки.Товар.Категория.Наименование,
    "return",
    Строки.Количество,
    Строки.СуммаВТенгеСНДС
ИЗ
    Документ.УчебныйВозврат.Строки КАК Строки
ГДЕ
    Строки.Ссылка.Проведен
    И Строки.Ссылка.Организация = &Организация
    И Строки.Ссылка.Дата >= &Начало
    И Строки.Ссылка.Дата < &Конец
