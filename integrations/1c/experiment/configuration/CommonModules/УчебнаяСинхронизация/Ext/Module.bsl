
// Путь подставляет сборщик только в копию конфигурации с приватным каталогом прогона.
Функция КаталогПилота()
    Возврат "__SAN1C_PILOT_DIRECTORY__";
КонецФункции

Функция ЗаданиеПилота()
    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(КаталогПилота() + "/pilot-job.json", "UTF-8");
    Данные = ПрочитатьJSON(Чтение, Истина);
    Чтение.Закрыть();
    Возврат Данные;
КонецФункции

Функция ОбработкаСтенда()
    // Единственная EPF, созданная Конфигуратором в каталоге этой лаборатории.
    Возврат ВнешниеОбработки.Создать(КаталогПилота() + "/San1CВыгрузка.epf", Ложь);
КонецФункции

Функция АдаптерПилота() Экспорт
    Возврат ВнешниеОбработки.Создать(КаталогПилота() + "/San1CАдаптер.epf", Ложь);
КонецФункции

Функция НачатьПилот() Экспорт
    Задание = ЗаданиеПилота();
    Этап = Задание.Получить("phase");
    Если Этап = "schedule" Тогда
        Расписание = Новый РасписаниеРегламентногоЗадания;
        Расписание.ПериодПовтораДней = 1;
        Расписание.ПериодПовтораВТечениеДня = 30;
        Работа = РегламентныеЗадания.СоздатьРегламентноеЗадание("УчебнаяВыгрузкаПродаж");
        Работа.Ключ = "San1C-lab";
        Работа.Использование = Истина;
        Работа.Расписание = Расписание;
        Работа.Записать();
        Возврат Истина;
    КонецЕсли;
    Обработка = ОбработкаСтенда();
    Если Этап = "first" Или Этап = "repeat" Тогда
        Обработка.ПроверитьУчебныйДень(КаталогПилота() + "/pilot-job.json");
    Иначе
        Обработка.ИсполнитьУчебнуюПроверку(Задание, Задание.Получить("result_file"));
    КонецЕсли;
    Возврат Ложь;
КонецФункции

Процедура ВыполнитьПоРасписанию() Экспорт
    Обработка = ОбработкаСтенда();
    Имя = КаталогПилота() + "/scheduled-" + Строка(Новый УникальныйИдентификатор()) + ".json";
    Попытка
        Задание = ЗаданиеПилота();
        Если НайтиФайлы(КаталогПилота(), "scheduled-*.json").Количество() = 0 Тогда
            Задание.Вставить("simulate_rejected_token", Истина);
        КонецЕсли;
        Принято = Обработка.ИсполнитьУчебнуюПроверку(Задание, Имя);
    Исключение
        Обработка.ЗаписатьРезультатПилота(Имя, Новый Структура("ok,message", Ложь,
            "Фоновое задание завершилось ошибкой. Проверьте журнал регистрации 1С."));
        ВызватьИсключение;
    КонецПопытки;
    Если Не Принято Тогда
        ВызватьИсключение "Учебная выгрузка не подтверждена. Подробности в локальной квитанции.";
    КонецЕсли;
КонецПроцедуры

Функция ЗавершитьРасписаниеЕслиГотово() Экспорт
    Если НайтиФайлы(КаталогПилота(), "scheduled-*.json").Количество() < 3 Тогда
        Возврат Ложь;
    КонецЕсли;
    Отбор = Новый Структура("Ключ", "San1C-lab");
    Для Каждого Работа Из РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор) Цикл
        Работа.Использование = Ложь;
        Работа.Записать();
    КонецЦикла;
    Возврат Истина;
КонецФункции
