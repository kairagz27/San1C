// Этот код присоединяется к модулю объекта только при сборке учебного стенда.
Процедура ПроверитьУчебныйДень(ИмяФайлаЗадания) Экспорт
    Задание = ПрочитатьФайлСтенда(ИмяФайлаЗадания);
    Среда = Новый СистемнаяИнформация;
    Итог = Новый Структура("stage,ok,platform,configuration,release,business_date",
        "configuration", Ложь, Среда.ВерсияПриложения, Метаданные.Имя, Метаданные.Версия, "2026-11-16");
    Попытка
        Если Метаданные.Имя <> "УчебнаяТорговля" Или Метаданные.Версия <> "1.0.0.1" Тогда
            ВызватьИсключение "Нужна отдельная учебная база версии 1.0.0.1.";
        КонецЕсли;
        Если Задание.Получить("phase") = "first" Тогда
            Итог.stage = "seed";
            СоздатьУчебныеДокументы();
        ИначеЕсли Задание.Получить("phase") <> "repeat" Тогда
            ВызватьИсключение "Неизвестный этап.";
        КонецЕсли;
        Итог.stage = "controls";
        ДеньПроверки = Дата(2026, 11, 16);
        Контроль = КонтрольИзБазы(ДеньПроверки);
        Итог.Вставить("controls", Контроль);
        Если Контроль.sales <> 10000 Или Контроль.returns <> 2000 Или Контроль.net <> 8000
            Или Контроль.sale_documents <> 1 Или Контроль.lines <> 2 Тогда
            ВызватьИсключение "Проверка данных перед выгрузкой не пройдена.";
        КонецЕсли;
        Итог.stage = "upload";
        Ключи = ПрочитатьФайлСтенда(Задание.Получить("credentials_file"));
        Квитанции = Новый Массив;
        ПортЛаборатории = Задание.Получить("port");
        Если ПортЛаборатории = Неопределено Тогда
            ПортЛаборатории = 8446;
        КонецЕсли;
        Ответ = ВыгрузитьПериод("localhost", ПортЛаборатории, Ключи.Получить("upload_token"),
            ДеньПроверки, ДеньПроверки, Задание.Получить("ca_file"), Квитанции);
        Итог.Вставить("message", Ответ);
        Итог.Вставить("receipts", Квитанции);
        Итог.ok = Квитанции.Количество() = 1;
        Если Итог.ok Тогда
            Итог.stage = "done";
        КонецЕсли;
    Исключение
        // Подробности исключения чтения JSON/HTTPS могут содержать секрет.
        Итог.Вставить("error", "Этап не завершён. Проверьте контрольные данные, модуль и локальные настройки.");
    КонецПопытки;
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(Задание.Получить("result_file"), "UTF-8");
    ЗаписатьJSON(Запись, Итог);
    Запись.Закрыть();
КонецПроцедуры

Функция ПрочитатьФайлСтенда(ПутьКФайлу)
    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(ПутьКФайлу, "UTF-8");
    ДанныеФайла = ПрочитатьJSON(Чтение, Истина);
    Чтение.Закрыть();
    Возврат ДанныеФайла;
КонецФункции

Функция СсылкаСтенда(Менеджер, Номер)
    ИД = Новый УникальныйИдентификатор("53b30828-2512-4419-8170-" + Прав("000000000000" + Номер, 12));
    Возврат Менеджер.ПолучитьСсылку(ИД);
КонецФункции

Функция ОбъектСправочникаСтенда(Менеджер, Номер, Название)
    Элемент = Менеджер.СоздатьЭлемент();
    Элемент.УстановитьСсылкуНового(СсылкаСтенда(Менеджер, Номер));
    Элемент.Наименование = Название;
    Возврат Элемент;
КонецФункции

Процедура СоздатьУчебныеДокументы()
    НачатьТранзакцию();
    Попытка
        Организация = ОбъектСправочникаСтенда(Справочники.УчебныеОрганизации, "1", "Учебная организация");
        Организация.Записать();
        Точка = ОбъектСправочникаСтенда(Справочники.УчебныеТочки, "2", "Учебная точка");
        Точка.Записать();
        Категория = ОбъектСправочникаСтенда(Справочники.УчебныеКатегории, "3", "Учебная категория");
        Категория.Записать();
        Товар = ОбъектСправочникаСтенда(Справочники.УчебныеТовары, "4", "Учебный товар");
        Товар.Категория = Категория.Ссылка;
        Товар.Записать();
        ПровестиДокументСтенда(Документы.УчебнаяПродажа, "5", Дата(2026, 11, 16, 10, 0, 0),
            Организация.Ссылка, Точка.Ссылка, Товар.Ссылка, 5, 10000);
        ПровестиДокументСтенда(Документы.УчебныйВозврат, "6", Дата(2026, 11, 16, 15, 0, 0),
            Организация.Ссылка, Точка.Ссылка, Товар.Ссылка, 1, 2000);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ПровестиДокументСтенда(Менеджер, Номер, ДатаДокумента, Организация, Точка, Товар, Количество, Сумма)
    ДокументУчета = Менеджер.СоздатьДокумент();
    ДокументУчета.УстановитьСсылкуНового(СсылкаСтенда(Менеджер, Номер));
    ДокументУчета.Дата = ДатаДокумента;
    ДокументУчета.Организация = Организация;
    ДокументУчета.Точка = Точка;
    СтрокаУчета = ДокументУчета.Строки.Добавить();
    СтрокаУчета.КлючСтроки = Строка(Новый УникальныйИдентификатор());
    СтрокаУчета.Товар = Товар;
    СтрокаУчета.Количество = Количество;
    СтрокаУчета.СуммаВТенгеСНДС = Сумма;
    ДокументУчета.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
КонецПроцедуры

Функция КонтрольИзБазы(ДеньПроверки, НомерТочки = "2")
    // Независимый контроль средствами 1С. Используются агрегаты по документам,
    // а не строки JSON, вычисленные константы или ответы API.
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
        |   ЕСТЬNULL(СУММА(Позиции.СуммаВТенгеСНДС), 0) КАК Сумма,
        |   КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Позиции.Ссылка) КАК Документов,
        |   КОЛИЧЕСТВО(*) КАК Строк,
        |   ""sale"" КАК Операция
        |ИЗ Документ.УчебнаяПродажа.Строки КАК Позиции
        |ГДЕ Позиции.Ссылка.Проведен И Позиции.Ссылка.Организация = &Организация
        |   И Позиции.Ссылка.Точка = &Точка
        |   И Позиции.Ссылка.Дата >= &Начало И Позиции.Ссылка.Дата < &Конец
        |ОБЪЕДИНИТЬ ВСЕ
        |ВЫБРАТЬ ЕСТЬNULL(СУММА(Позиции.СуммаВТенгеСНДС), 0), КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Позиции.Ссылка),
        |   КОЛИЧЕСТВО(*), ""return""
        |ИЗ Документ.УчебныйВозврат.Строки КАК Позиции
        |ГДЕ Позиции.Ссылка.Проведен И Позиции.Ссылка.Организация = &Организация
        |   И Позиции.Ссылка.Точка = &Точка
        |   И Позиции.Ссылка.Дата >= &Начало И Позиции.Ссылка.Дата < &Конец";
    Точка = СсылкаСтенда(Справочники.УчебныеТочки, НомерТочки);
    Запрос.УстановитьПараметр("Организация", СсылкаСтенда(Справочники.УчебныеОрганизации, "1"));
    Запрос.УстановитьПараметр("Точка", Точка);
    Запрос.УстановитьПараметр("Начало", ДеньПроверки);
    Запрос.УстановитьПараметр("Конец", ДеньПроверки + 86400);
    Итоги = Новый Структура("sales,returns,net,sale_documents,lines,store_name", 0, 0, 0, 0, 0, Точка.Наименование);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Если Выборка.Операция = "sale" Тогда
            Итоги.sales = Выборка.Сумма;
            Итоги.sale_documents = Выборка.Документов;
        Иначе
            Итоги.returns = Выборка.Сумма;
        КонецЕсли;
        Итоги.lines = Итоги.lines + Выборка.Строк;
    КонецЦикла;
    Итоги.net = Итоги.sales - Итоги.returns;
    Возврат Итоги;
КонецФункции
