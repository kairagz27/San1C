// Модуль входит только в учебную EPF. Специальные команды изменяют документы в отдельной ИБ.
Функция ИсполнитьУчебнуюПроверку(Задание, ИмяРезультата) Экспорт
    Среда = Новый СистемнаяИнформация;
    Итог = Новый Структура("phase,ok,platform,configuration,release", Задание.Получить("phase"),
        Ложь, Среда.ВерсияПриложения, Метаданные.Имя, Метаданные.Версия);
    Если Метаданные.Имя <> "УчебнаяТорговля" Или Метаданные.Версия <> "1.0.0.1" Тогда
        ВызватьИсключение "Нужна отдельная учебная база.";
    КонецЕсли;
    Этап = Итог.phase;
    Итог.Вставить("started_at_utc", Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z");
    Начало = Дата(2026, 11, 9);
    Конец = Дата(2026, 11, 22);
    Если Этап = "seed14" Тогда
        СоздатьДвеНедели(Начало);
    ИначеЕсли Этап = "correct" Или Этап = "unpost" Тогда
        ДокументУчета = СсылкаСтенда(Документы.УчебнаяПродажа, "100").ПолучитьОбъект();
        Если Этап = "correct" Тогда
            ДокументУчета.Строки[0].СуммаВТенгеСНДС = 1550.25;
            ДокументУчета.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
        Иначе
            ДокументУчета.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        КонецЕсли;
        Конец = Начало;
    ИначеЕсли Этап = "schedule" Тогда
        // Для реального расписания — последние три закрытых дня времени сеанса компании.
        Конец = НачалоДня(ТекущаяДатаСеанса()) - 86400;
        Начало = Конец - 2 * 86400;
    ИначеЕсли Этап <> "repeat14" Тогда
        ВызватьИсключение "Неизвестный этап учебного пилота.";
    КонецЕсли;
    Ключи = ПрочитатьФайлСтенда(Задание.Получить("credentials_file"));
    ТокенЗагрузки = Ключи.Получить("upload_token");
    Если Задание.Получить("simulate_rejected_token") = Истина Тогда
        ТокенЗагрузки = "rejected-scheduled-lab-token";
    КонецЕсли;
    ПортСтенда = Задание.Получить("port");
    Сертификат = Задание.Получить("ca_file");
    Адаптер = УчебнаяСинхронизация.АдаптерПилота();
    Если Этап = "seed14" Тогда
        Сегодня = НачалоДня(ТекущаяДатаСеанса());
        Итог.Вставить("open_day", Адаптер.ВыгрузитьПериод("localhost", ПортСтенда, ТокенЗагрузки, Сегодня, Сегодня, Сертификат));
        Проба = ПрочитатьПрофиль();
        Проба.Вставить("release", "несопоставленный релиз");
        Итог.Вставить("wrong_release", ПричинаОтказаПрофиля(Проба, Новый Массив));
        Проба = ПрочитатьПрофиль();
        Проба.Удалить("kzt_amount_metadata");
        Итог.Вставить("unconfirmed_kzt_amount", ПричинаОтказаПрофиля(Проба, Новый Массив));
        Проба = ПрочитатьПрофиль();
        Проба.Получить("required_metadata").Добавить("Документ.УчебнаяПродажа.Реквизит.НесуществующаяСумма");
        Итог.Вставить("missing_field", ПричинаОтказаПрофиля(Проба, Новый Массив));
        Итог.Вставить("rejected_token_check", Адаптер.ПроверитьПодключение("localhost", ПортСтенда, "rejected-lab-token", Сертификат));
    КонецЕсли;
    Проверка = Адаптер.ПроверитьПодключение("localhost", ПортСтенда, ТокенЗагрузки, Сертификат);
    Итог.Вставить("preflight", Проверка);
    Если Проверка.ok Тогда
        Контроль = Новый Массив;
        День = Начало;
        Пока День <= Конец Цикл
            Для Каждого Номер Из СтрРазделить("2,7", ",") Цикл
                СтрокаКонтроля = КонтрольИзБазы(День, Номер);
                СтрокаКонтроля.Вставить("date", Формат(День, "ДФ=yyyy-MM-dd"));
                СтрокаКонтроля.Вставить("point_id", ИдентификаторСсылки(СсылкаСтенда(Справочники.УчебныеТочки, Номер)));
                Контроль.Добавить(СтрокаКонтроля);
            КонецЦикла;
            День = День + 86400;
        КонецЦикла;
        Итог.Вставить("controls", Контроль);
        Квитанции = Новый Массив;
        Сообщение = Адаптер.ВыгрузитьПериод("localhost", ПортСтенда, ТокенЗагрузки, Начало, Конец, Сертификат, Квитанции);
        Итог.Вставить("message", Сообщение);
        Итог.Вставить("receipts", Квитанции);
        Итог.ok = Квитанции.Количество() = 1 + (Конец - Начало) / 86400;
    КонецЕсли;
    ЗаписатьРезультатПилота(ИмяРезультата, Итог);
    Возврат Итог.ok;
КонецФункции

Процедура ЗаписатьРезультатПилота(Путь, Данные) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(Путь, "UTF-8");
    ЗаписатьJSON(Запись, Данные);
    Запись.Закрыть();
КонецПроцедуры

Процедура СоздатьДвеНедели(Начало)
    НачатьТранзакцию();
    Попытка
        ТочкаБ = ОбъектСправочникаСтенда(Справочники.УчебныеТочки, "7", "Учебная точка Восток");
        ТочкаБ.Записать();
        ТочкаА = СсылкаСтенда(Справочники.УчебныеТочки, "2");
        Организация = СсылкаСтенда(Справочники.УчебныеОрганизации, "1");
        Товар = СсылкаСтенда(Справочники.УчебныеТовары, "4");
        Для ИндексДня = 0 По 13 Цикл
            Если ИндексДня = 2 Или ИндексДня = 7 Тогда
                // 11 ноября пусто в обеих точках, 16 ноября остаётся исходным регрессом.
                Продолжить;
            КонецЕсли;
            День = Начало + 86400 * ИндексДня;
            ПровестиДокументСтенда(Документы.УчебнаяПродажа, XMLСтрока(100 + ИндексДня), День + 36000,
                Организация, ТочкаА, Товар, 1, 1000 + ИндексДня * 10);
            Если ИндексДня % 2 = 0 Тогда
                ПровестиДокументСтенда(Документы.УчебнаяПродажа, XMLСтрока(200 + ИндексДня), День + 50000,
                    Организация, ТочкаБ.Ссылка, Товар, 2, 2100 + ИндексДня * 20);
            КонецЕсли;
            Если ИндексДня = 4 Или ИндексДня = 11 Тогда
                ПровестиДокументСтенда(Документы.УчебныйВозврат, XMLСтрока(300 + ИндексДня), День + 60000,
                    Организация, ТочкаБ.Ссылка, Товар, 1, 200 + ИндексДня);
            КонецЕсли;
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
