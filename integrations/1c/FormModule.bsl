&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПортAPI = 443;
    ДатаНачала = НачалоДня(ТекущаяДатаСеанса()) - 86400;
    ДатаОкончания = ДатаНачала;
КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)
    Попытка
        Результат = ПроверитьНаСервере();
        Сообщить("1С " + Результат.platform + " · " + Результат.configuration + " "
            + Результат.release + " · " + Результат.profile_id);
        Для Каждого Поле Из Результат.fields Цикл
            Сообщить(?(Поле.found, "✓ ", "× ") + Поле.name);
        КонецЦикла;
        Сообщить(Результат.message);
    Исключение
        Сообщить("Не удалось вызвать проверку на сервере 1С.");
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ПроверитьНаСервере()
    Обработка = РеквизитФормыВЗначение("Объект");
    Возврат Обработка.ПроверитьПодключение(СерверAPI, ПортAPI, Токен, ФайлСертификатов);
КонецФункции

&НаКлиенте
Процедура Выгрузить(Команда)
    Попытка
        Результат = ВыгрузитьНаСервере();
    Исключение
        Результат = "Вызов сервера 1С не завершён. Проверьте покрытие в San1C.";
    КонецПопытки;
    Токен = "";
    Сообщить(Результат);
КонецПроцедуры

&НаСервере
Функция ВыгрузитьНаСервере()
    // Объект — основной реквизит управляемой формы внешней обработки.
    Обработка = РеквизитФормыВЗначение("Объект");
    Возврат Обработка.ВыгрузитьПериод(СерверAPI, ПортAPI, Токен, ДатаНачала, ДатаОкончания, ФайлСертификатов);
КонецФункции
