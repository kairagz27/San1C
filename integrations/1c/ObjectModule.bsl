Функция ВыгрузитьПериод(СерверAPI, ПортAPI, Токен, ДатаНачала, ДатаОкончания,
    ФайлСертификатов = "", Квитанции = Неопределено) Экспорт
    Если ПустаяСтрока(СерверAPI) Или ПустаяСтрока(Токен) Или ПортAPI < 1 Или ПортAPI > 65535 Тогда
        Возврат "Введите имя сервера HTTPS, порт и токен загрузки.";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
        Возврат "Введите первую и последнюю даты периода.";
    КонецЕсли;
    ДатаДня = НачалоДня(ДатаНачала);
    ПоследнийДень = НачалоДня(ДатаОкончания);
    Если ПоследнийДень >= НачалоДня(ТекущаяДатаСеанса()) Тогда
        Возврат "Выберите закрытый день. Последняя доступная дата — "
            + Формат(НачалоДня(ТекущаяДатаСеанса()) - 86400, "ДФ=dd.MM.yyyy") + ".";
    КонецЕсли;
    Если ДатаДня > ПоследнийДень Тогда
        Возврат "Проверьте порядок дат и дату окончания периода.";
    КонецЕсли;

    Проверка = ПроверитьПодключение(СерверAPI, ПортAPI, Токен, ФайлСертификатов);
    Если Не Проверка.ok Тогда
        Возврат Проверка.message;
    КонецЕсли;
    ТекстЗапроса = ПолучитьМакет("ЗапросДня").ПолучитьТекст();
    Профиль = ПрочитатьПрофиль();
    Организация = ОрганизацияПрофиля(Профиль);
    ТочкиПилота = Новый Массив;
    Если Профиль.Получить("pilot_points") <> Неопределено Тогда
        Для Каждого ОписаниеТочки Из Профиль.Получить("pilot_points") Цикл
            ТочкиПилота.Добавить(НРег(ОписаниеТочки.Получить("id")));
        КонецЦикла;
    КонецЕсли;
    Соединение = СоединениеСAPI(СерверAPI, ПортAPI, ФайлСертификатов);

    ПринятоДней = 0;
    Пока ДатаДня <= ПоследнийДень Цикл
        // Порядок версий определяется началом чтения. Длительный старый запрос
        // не сможет заменить более новую выборку, если придет на API позднее.
        ВремяЧтения = ТекущаяУниверсальнаяДата();
        Метка = Формат(ВремяЧтения, "ДФ=yyyy-MM-dd") + "T" + Формат(ВремяЧтения, "ДФ=HH:mm:ss") + "Z";
        ДатаISO = Формат(ДатаДня, "ДФ=yyyy-MM-dd");
        Снимок = Новый Структура("business_date,generated_at,complete,row_count,rows",
            ДатаISO, Метка, Ложь, 0, Новый Массив);
        Попытка
            СтрокиДня = ПрочитатьДень(ТекстЗапроса, ДатаДня, Организация, ТочкиПилота);
            Снимок.rows = СтрокиДня;
            Снимок.row_count = СтрокиДня.Количество();
            Снимок.complete = Истина;
            Пакет = ПодготовитьHTTPЗапрос(Снимок, Токен);
        Исключение
            // Неполный снимок сообщает о пропуске и сохраняет прежние факты.
            Снимок.complete = Ложь;
            Снимок.rows = Новый Массив;
            Снимок.row_count = 0;
            Попытка
                Соединение.ВызватьHTTPМетод("POST", ПодготовитьHTTPЗапрос(Снимок, Токен));
            Исключение
                Возврат "Не удалось уведомить API о неполном дне " + ДатаISO
                    + ". Повторите выгрузку с этой даты.";
            КонецПопытки;
            Возврат "Ошибка подготовки полного снимка за " + ДатаISO
                + ". Проверьте шаблон, поля и лимит дня. Повторите выгрузку с этой даты.";
        КонецПопытки;

        Попытка
            Ответ = Соединение.ВызватьHTTPМетод("POST", Пакет);
        Исключение
            Возврат "Нет подтверждения API за " + ДатаISO + ". Проверьте HTTPS и повторите с этой даты.";
        КонецПопытки;
        Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
            Возврат "Выгрузка остановлена на " + ДатаISO + ", HTTP " + Строка(Ответ.КодСостояния)
                + ". Проверьте журнал источника в San1C и повторите с этой даты.";
        КонецЕсли;
        КвитанцияДня = ПровереннаяКвитанция(Ответ, Снимок);
        Если КвитанцияДня = Неопределено Тогда
            Возврат "Нет квитанции San1C за " + ДатаISO + ". Проверьте адрес, журнал и повторите с этой даты.";
        КонецЕсли;
        Если Квитанции <> Неопределено Тогда
            Квитанции.Добавить(КвитанцияДня);
        КонецЕсли;
        ПринятоДней = ПринятоДней + 1;
        ДатаДня = ДатаДня + 86400;
    КонецЦикла;
    Возврат "Выгрузка завершена. Принято дней — " + Строка(ПринятоДней) + ".";
КонецФункции

Функция ПрочитатьПрофиль()
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ПолучитьМакет("Профиль").ПолучитьТекст());
    Профиль = ПрочитатьJSON(Чтение, Истина);
    Чтение.Закрыть();
    Возврат Профиль;
КонецФункции

Функция ОрганизацияПрофиля(Профиль)
    МенеджерОрганизаций = Справочники[Профиль.Получить("organization_catalog")];
    Организация = МенеджерОрганизаций.ПолучитьСсылку(Новый УникальныйИдентификатор(Профиль.Получить("organization_uuid")));
    Если Не ЗначениеЗаполнено(Организация) Или Организация.ПолучитьОбъект() = Неопределено Тогда
        ВызватьИсключение "Организация профиля отсутствует.";
    КонецЕсли;
    Возврат Организация;
КонецФункции

Функция СоединениеСAPI(СерверAPI, ПортAPI, ФайлСертификатов)
    Если ПустаяСтрока(ФайлСертификатов) Тогда
        Центры = Новый СертификатыУдостоверяющихЦентровОС;
    Иначе
        Центры = Новый СертификатыУдостоверяющихЦентровФайл(ФайлСертификатов);
    КонецЕсли;
    Возврат Новый HTTPСоединение(СерверAPI, ПортAPI, , , , 60, Новый ЗащищенноеСоединениеOpenSSL(, Центры));
КонецФункции

Функция ПроверитьПодключение(СерверAPI, ПортAPI, Токен, ФайлСертификатов = "") Экспорт
    Среда = Новый СистемнаяИнформация;
    Проверка = Новый Структура("ok,platform,configuration,release,profile_id,fields,http_status,message",
        Ложь, Среда.ВерсияПриложения, Метаданные.Имя, Метаданные.Версия, "", Новый Массив, 0, "");
    Попытка
        Проверка.message = "Добавьте в обработку согласованный макет Профиль.";
        Профиль = ПрочитатьПрофиль();
        Проверка.profile_id = Профиль.Получить("id");
        Проверка.message = "Проверьте структуру профиля и имена объектов метаданных.";
        ПричинаОтказа = ПричинаОтказаПрофиля(Профиль, Проверка.fields);
        Если Не ПустаяСтрока(ПричинаОтказа) Тогда
            Проверка.message = ПричинаОтказа;
            Возврат Проверка;
        КонецЕсли;
        Проверка.message = "Проверьте справочник, UUID организации профиля и права чтения.";
        Организация = ОрганизацияПрофиля(Профиль);
        // Пустой полуинтервал проверяет компиляцию запроса и права без выгрузки операций.
        Проверка.message = "Запрос профиля не исполнился. Проверьте имена полей, параметры и права чтения.";
        Проба = Новый Запрос(ПолучитьМакет("ЗапросДня").ПолучитьТекст());
        Проба.УстановитьПараметр("Начало", НачалоДня(ТекущаяДатаСеанса()));
        Проба.УстановитьПараметр("Конец", НачалоДня(ТекущаяДатаСеанса()));
        Проба.УстановитьПараметр("Организация", Организация);
        Проба.Выполнить();
        Если ПустаяСтрока(СерверAPI) Или ПустаяСтрока(Токен) Или ПортAPI < 1 Или ПортAPI > 65535 Тогда
            Проверка.message = "Введите сервер HTTPS, порт и токен загрузки.";
            Возврат Проверка;
        КонецЕсли;
        Проверка.message = "Нет ответа HTTPS. Проверьте DNS, порт, сертификат и доступ из сеанса 1С.";
        Соединение = СоединениеСAPI(СерверAPI, ПортAPI, ФайлСертификатов);
        Пакет = Новый HTTPЗапрос("/api/import/check");
        Пакет.Заголовки.Вставить("Authorization", "Bearer " + Токен);
        Ответ = Соединение.ВызватьHTTPМетод("GET", Пакет);
        Проверка.http_status = Ответ.КодСостояния;
        Если Ответ.КодСостояния <> 200 Тогда
            Проверка.message = "Проверка API: HTTP " + Строка(Ответ.КодСостояния)
                + ". При 401/403 проверьте токен загрузки, при 404 — маршрут /api/import/check.";
            Возврат Проверка;
        КонецЕсли;
        Проверка.message = "API вернул неожиданный ответ. Проверьте адрес и профиль экземпляра San1C.";
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
        Паспорт = ПрочитатьJSON(Чтение, Истина);
        Чтение.Закрыть();
        Если Паспорт.Получить("profile_id") <> Проверка.profile_id
            Или Паспорт.Получить("configuration") <> Проверка.configuration Или Паспорт.Получить("release") <> Проверка.release
            Или НРег(Строка(Паспорт.Получить("organization_uuid"))) <> НРег(Профиль.Получить("organization_uuid")) Тогда
            Проверка.message = "Профиль San1C и обработки различается. Установите один согласованный профиль.";
            Возврат Проверка;
        КонецЕсли;
        Если Не СовпадаютТочки(Профиль.Получить("pilot_points"), Паспорт.Получить("pilot_points")) Тогда
            Проверка.message = "Различаются UUID или названия согласованных точек в профилях San1C и обработки.";
            Возврат Проверка;
        КонецЕсли;
    Исключение
        Возврат Проверка;
    КонецПопытки;
    Проверка.ok = Истина;
    Проверка.message = "Объекты, поля, права чтения и профиль HTTPS проверены.";
    Возврат Проверка;
КонецФункции

Функция ПричинаОтказаПрофиля(Профиль, Поля)
    Если Профиль.Получить("configuration") <> Метаданные.Имя Или Профиль.Получить("release") <> Метаданные.Версия Тогда
        Возврат "Для " + Метаданные.Имя + " " + Метаданные.Версия
            + " нужен профиль по экспорту метаданных и контрольному отчёту этой базы.";
    КонецЕсли;
    ПоляСуммы = Профиль.Получить("kzt_amount_metadata");
    Если Профиль.Получить("currency") <> "KZT" Или Профиль.Получить("amount_includes_vat") <> Истина
        Или ПоляСуммы = Неопределено Или ПоляСуммы.Количество() = 0 Тогда
        Возврат "Подтвердите реквизит суммы в KZT после скидок с НДС для обеих операций.";
    КонецЕсли;
    Реквизиты = Профиль.Получить("required_metadata");
    Если Реквизиты = Неопределено Или Реквизиты.Количество() = 0 Тогда
        Возврат "В профиле отсутствует перечень проверяемых объектов и реквизитов.";
    КонецЕсли;
    Для Каждого ПолеСуммы Из ПоляСуммы Цикл
        Если Реквизиты.Найти(ПолеСуммы) = Неопределено Тогда
            Реквизиты.Добавить(ПолеСуммы);
        КонецЕсли;
    КонецЦикла;
    Пропуски = Новый Массив;
    Для Каждого Путь Из Реквизиты Цикл
        Найден = Метаданные.НайтиПоПолномуИмени(Путь) <> Неопределено;
        Поля.Добавить(Новый Структура("name,found", Путь, Найден));
        Если Не Найден Тогда
            Пропуски.Добавить(Путь);
        КонецЕсли;
    КонецЦикла;
    Если Пропуски.Количество() > 0 Тогда
        Возврат "В метаданных отсутствуют: " + СтрСоединить(Пропуски, ", ");
    КонецЕсли;
    Возврат "";
КонецФункции

Функция СовпадаютТочки(Локальные, Серверные)
    Если Локальные = Неопределено Тогда
        Возврат Серверные = Неопределено Или Серверные.Количество() = 0;
    КонецЕсли;
    Если Серверные = Неопределено Или Локальные.Количество() <> Серверные.Количество() Тогда
        Возврат Ложь;
    КонецЕсли;
    Имена = Новый Соответствие;
    Для Каждого Точка Из Серверные Цикл
        Имена.Вставить(НРег(Точка.Получить("id")), Точка.Получить("name"));
    КонецЦикла;
    Для Каждого Точка Из Локальные Цикл
        ИД = НРег(Точка.Получить("id"));
        Если Имена.Получить(ИД) <> Точка.Получить("name") Тогда
            Возврат Ложь;
        КонецЕсли;
        Имена.Удалить(ИД);
    КонецЦикла;
    Возврат Имена.Количество() = 0;
КонецФункции

Функция ПрочитатьДень(ТекстЗапроса, ДатаДня, Организация, ТочкиПилота)
    Запрос = Новый Запрос(ТекстЗапроса);
    Запрос.УстановитьПараметр("Начало", ДатаДня);
    Запрос.УстановитьПараметр("Конец", ДатаДня + 86400);
    Запрос.УстановитьПараметр("Организация", Организация);
    Выборка = Запрос.Выполнить().Выбрать();
    СтрокиДня = Новый Массив;
    Пока Выборка.Следующий() Цикл
        ИДТочки = ИдентификаторСсылки(Выборка.Точка);
        Если ТочкиПилота.Количество() > 0 И ТочкиПилота.Найти(НРег(ИДТочки)) = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если СтрокиДня.Количество() >= 10000 Тогда
            ВызватьИсключение "Превышен лимит строк дневного снимка.";
        КонецЕсли;
        ДокументИД = ИдентификаторСсылки(Выборка.ДокументОперации);
        Если Не ЗначениеЗаполнено(Выборка.КлючСтроки) Тогда
            ВызватьИсключение "Отсутствует постоянный ключ строки.";
        КонецЕсли;
        ДанныеСтроки = Новый Структура;
        ДанныеСтроки.Вставить("business_date", Формат(Выборка.ДатаОперации, "ДФ=yyyy-MM-dd"));
        ДанныеСтроки.Вставить("line_id", ДокументИД + "/" + Строка(Выборка.КлючСтроки));
        ДанныеСтроки.Вставить("document_id", ДокументИД);
        ДанныеСтроки.Вставить("store_id", ИДТочки);
        ДанныеСтроки.Вставить("store_name", Выборка.НазваниеТочки);
        ДанныеСтроки.Вставить("product_id", ИдентификаторСсылки(Выборка.Товар));
        ДанныеСтроки.Вставить("product_name", Выборка.НазваниеТовара);
        ДанныеСтроки.Вставить("category_id", ИдентификаторСсылки(Выборка.Категория));
        ДанныеСтроки.Вставить("category_name", Выборка.НазваниеКатегории);
        ДанныеСтроки.Вставить("operation", Выборка.ВидОперации);
        ДанныеСтроки.Вставить("quantity", XMLСтрока(Выборка.Количество));
        ДанныеСтроки.Вставить("amount", XMLСтрока(Выборка.Сумма));
        СтрокиДня.Добавить(ДанныеСтроки);
    КонецЦикла;
    Возврат СтрокиДня;
КонецФункции

Функция ИдентификаторСсылки(Ссылка)
    Если Не ЗначениеЗаполнено(Ссылка) Тогда
        ВызватьИсключение "Отсутствует обязательная ссылка профиля.";
    КонецЕсли;
    Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция ПровереннаяКвитанция(Ответ, Снимок)
    Попытка
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
        Квитанция = ПрочитатьJSON(Чтение, Истина);
        Чтение.Закрыть();
        Статус = Квитанция.Получить("status");
        Если (Статус = "accepted" Или Статус = "unchanged")
            И Квитанция.Получить("business_date") = Снимок.business_date
            И Квитанция.Получить("row_count") = Снимок.row_count Тогда
            Возврат Новый Структура("status,http_status,business_date,row_count,generated_at",
                Статус, Ответ.КодСостояния, Снимок.business_date, Снимок.row_count, Снимок.generated_at);
        КонецЕсли;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
    Возврат Неопределено;
КонецФункции

Функция ПодготовитьHTTPЗапрос(Снимок, Токен)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Снимок);
    Тело = Запись.Закрыть();
    ЗапросHTTP = Новый HTTPЗапрос("/api/import/days");
    ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    ЗапросHTTP.Заголовки.Вставить("Authorization", "Bearer " + Токен);
    ЗапросHTTP.Заголовки.Вставить("X-Business-Date", Снимок.business_date);
    ЗапросHTTP.Заголовки.Вставить("X-Snapshot-Generated-At", Снимок.generated_at);
    ЗапросHTTP.УстановитьТелоИзСтроки(Тело, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
    Если ЗапросHTTP.ПолучитьТелоКакДвоичныеДанные().Размер() > 4194304 Тогда
        ВызватьИсключение "Превышен лимит размера дневного снимка.";
    КонецЕсли;
    Возврат ЗапросHTTP;
КонецФункции
